# Queue service configuration. Copy to .env and fill in. .env is gitignored; this file is not.
# Real shell environment variables always win over anything set here (settings.py uses setdefault).

# Django's signing key. Nothing on the hot path uses it (no sessions, no CSRF, no admin), but an
# unset value fails at the first line of code that ever does. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me

# NEVER 1 under load: DEBUG=True retains data per request and is an information leak.
DJANGO_DEBUG=0

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# The queue service's entire state. No database, by design.
REDIS_URL=redis://127.0.0.1:6379/0

# Bounded so a dead Redis becomes a fast 503 instead of a request that never returns.
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_CONNECT_TIMEOUT_SECONDS=2.0

# MUST match booking_service/.env exactly — this service signs the passes that one
# verifies. Copy the value across; do not generate a second one.
ADMISSION_TOKEN_SECRET=replace-me-must-match-booking-service
ADMISSION_PASS_TTL_SECONDS=60
ADMISSION_TICK_SECONDS=1.0
