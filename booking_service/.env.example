# Copy this file to .env (which is gitignored) and fill in real local values.
# The .env loader reads values verbatim — do NOT wrap them in quotes.

# Django — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key

# PostgreSQL
DB_NAME=queuefair
DB_USER=queuefair
DB_PASSWORD=your-local-db-password
DB_HOST=127.0.0.1
DB_PORT=5433

# Admission tokens — shared HS256 secret (must match the queue service's signing secret).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMISSION_TOKEN_SECRET=a-shared-hs256-secret-both-services-use
